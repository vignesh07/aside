{
  "name": "aside",
  "version": "0.1.0",
  "description": "A read-only side chat that watches your agent session (Claude Code, Codex) so you can ask questions without branching the main thread.",
  "type": "module",
  "bin": {
    "aside": "./dist/cli.js"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.55.0",
    "chalk": "^5.4.1",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "meow": "^13.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
