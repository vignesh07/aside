{
  "name": "@vignesh07/aside",
  "version": "0.1.0",
  "description": "A read-only bird's-eye chat for your AI coding agents. Watches every Claude Code, Codex, and Pi session on your machine and answers questions across all of them — without interrupting any of them.",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "observability",
    "tui",
    "cli",
    "read-only",
    "agent-monitoring"
  ],
  "homepage": "https://github.com/vignesh07/aside#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vignesh07/aside.git"
  },
  "bugs": {
    "url": "https://github.com/vignesh07/aside/issues"
  },
  "type": "module",
  "bin": {
    "aside": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/smoke.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "preview": "node scripts/preview.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@mariozechner/pi-ai": "^0.55.0",
    "chalk": "^5.4.1",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "meow": "^13.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
