{
  "name": "@vignesh07/aside",
  "version": "0.2.1",
  "private": true,
  "description": "Persistent read-only side chats for every Claude Code, Codex, Pi, and OpenCode session on your machine, plus one fleet-wide thread.",
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "ai-agents",
    "observability",
    "tui",
    "cli",
    "read-only",
    "agent-monitoring",
    "side-chat"
  ],
  "homepage": "https://aside.vgnsh.xyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vignesh07/aside.git"
  },
  "bugs": {
    "url": "https://github.com/vignesh07/aside/issues"
  },
  "type": "module",
  "workspaces": [
    "distribution"
  ],
  "bin": {
    "aside": "./dist/cli.js"
  },
  "files": [
    "dist",
    "scripts/smoke.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "node scripts/clean-build.mjs && tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "preview": "node scripts/preview.mjs",
    "smoke": "node scripts/smoke.mjs",
    "serve:releases": "npm --workspace @aside/release-distribution start",
    "release:publish": "railway run --service aside npm --workspace @aside/release-distribution run publish",
    "release:publish:dry": "npm --workspace @aside/release-distribution run publish -- --dry-run",
    "test": "npm run build && vitest run --exclude 'website/**'",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "ink": "^5.1.0",
    "ink-text-input": "^6.0.0",
    "meow": "^13.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=22.16"
  },
  "license": "MIT"
}
