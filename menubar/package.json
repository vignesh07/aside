{
  "name": "@aside/menubar",
  "version": "0.1.2",
  "private": true,
  "description": "macOS menubar frontend for aside — reuses the same TS core as the TUI.",
  "author": "Vignesh Natarajan",
  "engines": {
    "node": ">=22.12"
  },
  "type": "module",
  "main": "build/main.js",
  "scripts": {
    "build": "tsc",
    "icons": "electron scripts/build-icons.mjs",
    "bundle": "npm --prefix .. run build && node scripts/bundle.mjs",
    "clean:release": "node scripts/clean-release.mjs",
    "start": "npm run bundle && electron build/main.js",
    "pack": "npm run bundle && electron-builder --mac --dir --arm64",
    "pack:x64": "npm run bundle && electron-builder --mac --dir --x64",
    "dist": "npm run clean:release && npm run bundle && electron-builder --mac --arm64 --x64",
    "verify:signing": "node scripts/verify-signing.mjs",
    "sign:dmg": "node scripts/sign-dmg.mjs",
    "release": "npm run dist && npm run sign:dmg"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/fuses": "^1.8.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "typescript": "^5.7.0"
  }
}
